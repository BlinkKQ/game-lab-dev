; Godot 4.6.3 — GameLab Minigolfe
config_version=5

[application]
config/name="GameLab Minigolfe 3D"
config/version="0.2.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="Minigolfe 3D offline, com três percursos, rampas e pequenos saltos."
config/use_custom_user_dir=true
config/custom_user_dir_name="GameLab Minigolfe"

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=432
window/size/window_height_override=768
window/handheld/orientation=1
window/dpi/allow_hidpi=true

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[physics]
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.062745, 0.094118, 0.152941, 1)
